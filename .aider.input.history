+                                                                               
+ <<<<<<< SEARCH                                                                
+ // ==================== DELETE — DELETE AGENT ====================            
+                                                                               
+ export async function DELETE(request: NextRequest) {                          
+   try {                                                                       
+     const { searchParams } = new URL(request.url)                             
+     const id = searchParams.get('id')                                         
+                                                                               
+     if (!id) {                                                                
+       return NextResponse.json({ error: 'Agent ID là bắt buộc (?id=xxx)' }, { 
+ status: 400 })                                                                
+     }                                                                         
+                                                                               
+     // Check agent exists                                                     
+     const existing = await db.agentProfile.findUnique({ where: { id } })      
+     if (!existing) {                                                          
+       return NextResponse.json({ error: 'Agent không tồn tại' }, { status:    
+ 404 })                                                                        
+     }                                                                         
+                                                                               
+     // Protect system agents from deletion                                    
+     if (existing.isSystem) {                                                  
+       return NextResponse.json({ error: `Agent hệ thống "${existing.name}"    
+ không thể xóa. Bạn có thể tắt (disable) hoặc tùy chỉnh thay vì xóa.` }, {     
+ status: 403 })                                                                
+     }                                                                         
+                                                                               
+     // Unlink all related sessions (set agentProfileId = null, keep chat      
+ history)                                                                      
+     await db.agentSession.updateMany({                                        
+       where: { agentProfileId: id },                                          
+       data: { agentProfileId: null },                                         
+     })                                                                        
+                                                                               
+     // Delete the agent                                                       
+     await db.agentProfile.delete({ where: { id } })                           
+                                                                               
+     return NextResponse.json({                                                
+       success: true,                                                          
+       deletedAgent: { id, name: existing.name },                              
+       message: `Đã xóa Agent "${existing.name}". Các phiên chat liên quan     
+ được giữ lại.`,                                                               
+     })                                                                        
+   } catch (err) {                                                             
+     return NextResponse.json(                                                 
+       { error: 'Failed to delete agent', details: err instanceof Error ?      
+ err.message : String(err) },                                                  
+       { status: 500 }                                                         
+     )                                                                         
+   }                                                                           
+ }                                                                             
+ =======                                                                       
+ // ==================== DELETE — SOFT DELETE AGENT ====================       
+                                                                               
+ /**                                                                           
+  * Soft delete an agent by ID.                                                
+  * - System agents cannot be deleted.                                         
+  * - Agents with active tasks cannot be deleted.                              
+  * - Unlinks related sessions (sets agentProfileId = null).                   
+  * - Sets deletedAt timestamp instead of hard delete.                         
+  */                                                                           
+ export async function DELETE(request: NextRequest) {                          
+   try {                                                                       
+     const { searchParams } = new URL(request.url)                             
+     const id = searchParams.get('id')                                         
+                                                                               
+     if (!id) {                                                                
+       return NextResponse.json({ ok: false, error: 'Agent ID là bắt buộc      
+ (?id=xxx)' }, { status: 400 })                                                
+     }                                                                         
+                                                                               
+     // Check agent exists and is not already deleted                          
+     const existing = await retryDbOp(() => db.agentProfile.findFirst({        
+       where: { id, deletedAt: null }                                          
+     }))                                                                       
+     if (!existing) {                                                          
+       return NextResponse.json({ ok: false, error: 'Agent không tồn tại hoặc  
+ đã bị xóa' }, { status: 404 })                                                
+     }                                                                         
+                                                                               
+     // Protect system agents from deletion                                    
+     if (existing.isSystem) {                                                  
+       return NextResponse.json({ ok: false, error: `Agent hệ thống            
+ "${existing.name}" không thể xóa. Bạn có thể tắt (disable) hoặc tùy chỉnh     
+ thay vì xóa.` }, { status: 403 })                                             
+     }                                                                         
+                                                                               
+     // Check if agent has active tasks (pending or running)                   
+     const activeTasks = await retryDbOp(() => db.smolabTask.count({           
+       where: {                                                                
+         agentProfileId: id,                                                   
+         status: { in: ['pending', 'running'] }                                
+       }                                                                       
+     }))                                                                       
+     if (activeTasks > 0) {                                                    
+       return NextResponse.json({                                              
+         ok: false,                                                            
+         error: `Không thể xóa Agent "${existing.name}" vì đang có             
+ ${activeTasks} task đang chạy hoặc chờ xử lý. Vui lòng hủy hoặc chờ hoàn      
+ thành.`                                                                       
+       }, { status: 409 })                                                     
+     }                                                                         
+                                                                               
+     // Unlink all related sessions (set agentProfileId = null, keep chat      
+ history)                                                                      
+     await retryDbOp(() => db.agentSession.updateMany({                        
+       where: { agentProfileId: id },                                          
+       data: { agentProfileId: null },                                         
+     }))                                                                       
+                                                                               
+     // Soft delete the agent                                                  
+     await retryDbOp(() => db.agentProfile.update({                            
+       where: { id },                                                          
+       data: { deletedAt: new Date(), enabled: false }                         
+     }))                                                                       
+                                                                               
+     return NextResponse.json({                                                
+       ok: true,                                                               
+       data: {                                                                 
+         deletedAgent: { id, name: existing.name },                            
+         message: `Đã xóa Agent "${existing.name}". Các phiên chat liên quan   
+ được giữ lại.`                                                                
+       }                                                                       
+     })                                                                        
+   } catch (err) {                                                             
+     const errMsg = err instanceof Error ? err.message : String(err)           
+     console.error('[Agents API] DELETE error:', errMsg)                       
+     return NextResponse.json(                                                 
+       { ok: false, error: 'Failed to delete agent', details: errMsg },        
+       { status: 500 }                                                         
+     )                                                                         
+   }                                                                           
+ }                                                                             
+ >>>>>>> REPLACE                                                               
+                                                                               
+
