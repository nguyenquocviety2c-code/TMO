# ============================================
# GraphRAG Knowledge Base — Environment Configuration
# ============================================
# Architecture: SQLite (buffer) → Qdrant (vector+document) + Neo4j (graph)
#
# Prerequisites:
#   1. Qdrant vector database running on localhost:6333 (REQUIRED)
#   2. At least one LLM provider API key configured (REQUIRED)
#   3. Neo4j running on localhost:7687 (OPTIONAL — only for Knowledge Graph)
#
# Setup:
#   cp .env.example .env
#   # Fill in your API keys
#   bun run setup    # Generate Prisma client + push DB schema
#   bun run dev      # Start the development server on port 3000
# ============================================

# ============================================
# DATABASE (Prisma SQLite — local buffer layer)
# ============================================
DATABASE_URL=file:../db/custom.db

# ============================================
# FILE STORAGE
# Upload directory for PDF files (default: /tmp/theopus-uploads)
# ============================================
# UPLOAD_DIR=/tmp/theopus-uploads

# ============================================
# QDRANT CONFIGURATION (Vector Database)
# Handles: Document metadata, Chunk text+embeddings, Semantic search
# Install: Download binary from https://github.com/qdrant/qdrant/releases
# Start:   ./qdrant --config-path qdrant-config.yaml
# Config:  See qdrant-config.yaml in project root
# Collections are auto-created on first health check or via POST /api/setup/qdrant
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCUMENTS=theopus_documents
QDRANT_COLLECTION_CHUNKS=theopus_chunks

# ============================================
# NEO4J CONFIGURATION (Graph Database) — OPTIONAL
# Handles: Entities, Relationships, Knowledge Graph traversal
# If not running, the app still works fine (chat, agents, skills, memory)
# Only needed if you want Knowledge Graph features
#
# === SETUP WITH NEO4J DESKTOP ===
# 1. Download & install: https://neo4j.com/download/
# 2. Open Neo4j Desktop → Create new Project → Add Database → Start
# 3. Set password when prompted (remember it for NEO4J_PASSWORD below)
# 4. Default bolt port: 7687, HTTP: 7474
# 5. IMPORTANT: Use bolt:// (NOT neo4j://) for Desktop single-instance
#    - bolt://127.0.0.1:7687  ← CORRECT for Desktop
#    - neo4j://127.0.0.1:7687 ← WRONG (causes "Could not perform discovery" error)
#
# === SETUP WITH DOCKER ===
# docker run -d --name neo4j -p 7474:7474 -p 7687:7687 \
#   -e NEO4J_AUTH=neo4j/your-password neo4j:latest
#
# === SETUP WITH NEO4J AURADB (Cloud) ===
# Change URI to: neo4j+s://<instance-id>.databases.neo4j.io
#
# === VERIFY CONNECTION ===
# Open browser: http://localhost:7474 — should show Neo4j Browser
# ============================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ============================================
# NVIDIA NIM API CONFIGURATION (4 keys for rotation)
# Architecture: NVIDIA NIM ONLY (single provider)
#   - 2 extraction cores: llama-3.3-70b, gpt-oss-120b
#   - 5 agent/chat cores: deepseek-v4-pro, kimi-k2.6, glm-5.1, minimax-m2.7, qwen3.5-397b
#   - NOT using: deepseek-v4-flash
# Get keys: https://build.nvidia.com/
# Rate limit: 40 RPM per key, no daily cap
# Auto mode: 4 keys × 4 docs/key = 16 max concurrent documents
# ============================================
NVIDIA_API_KEY_1=your-nvidia-key-1
NVIDIA_API_KEY_2=your-nvidia-key-2
NVIDIA_API_KEY_3=your-nvidia-key-3
NVIDIA_API_KEY_4=your-nvidia-key-4

# NVIDIA Embedding Model Configuration
# Model: nvidia/llama-nemotron-embed-1b-v2 (Matryoshka, supports dynamic dimensions)
# Previous model nvidia/embed-qa-4 is DEPRECATED (returns 404)
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBED_DIMENSIONS=1536

# REMOVED: Mistral, Cerebras, OpenRouter are no longer used.
# Only NVIDIA NIM is configured as the single LLM provider.
# These env vars are ignored if present:
# MISTRAL_API_KEY_1..4
# CEREBRAS_API_KEY_1..4
# OPENROUTER_API_KEY_1..4
# ENABLE_CEREBRAS

# ============================================
# OPENCLAW GATEWAY CONFIGURATION
# Self-hosted AI Agent Gateway — runs on port 18789
# Optional: If not running, the app falls back to direct LLM provider calls
# Get: https://github.com/agenthub/openclaw
# ============================================
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_AUTH_MODE=none

# ============================================
# OPENCODE SERVER CONFIGURATION
# AI Coding Agent Server — runs on port 18790
# Custom Hono HTTP server providing file ops, bash, LSP, MCP bridge
# Used by Code Team agents for code operations (read/write/bash)
# If not running, agents fall back to direct file system operations
# ============================================
OPENCODE_SERVER_URL=http://127.0.0.1:18790
OPENCODE_SERVER_PORT=18790
# Set to the absolute path of your project directory on your machine
OPENCODE_WORKSPACE=.

# ============================================
# CODE TEAM SKILLS — Web Search & Reader APIs
# Multi-key rotation with automatic fallback on rate limit/auth errors
# Fallback: If keys are missing, z-ai-web-dev-sdk provides automatic fallback
#           (only works inside z.ai sandbox environment)
# ============================================

# Tavily: AI-optimized deep web search for AI Agents (4 keys for rotation)
# Rate limit: ~1000 requests/month per key
TAVILY_API_KEY_1=your-tavily-key-1
TAVILY_API_KEY_2=your-tavily-key-2
TAVILY_API_KEY_3=your-tavily-key-3
TAVILY_API_KEY_4=your-tavily-key-4

# Jina Reader: Read and extract content from any web page (2+ keys for rotation)
# Rate limit: 1M tokens/month per key
JINA_API_KEY_1=your-jina-key-1
JINA_API_KEY_2=your-jina-key-2

# Serper: Google Search API for programmatic search (4 keys for rotation)
# Rate limit: 25,000 searches/month per key
SERPER_API_KEY_1=your-serper-key-1
SERPER_API_KEY_2=your-serper-key-2
SERPER_API_KEY_3=your-serper-key-3
SERPER_API_KEY_4=your-serper-key-4

# ============================================
# APPLICATION BASE URL
# Used for internal API calls (knowledge bridge, etc.)
# In development, this is typically http://localhost:3000
# In production, set to your actual domain
# ============================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000
